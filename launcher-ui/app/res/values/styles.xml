<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The light background already in the window: opening the home screen never flashes another color. -->
    <color name="home_background">#EBEBF0</color>

    <style name="Noiro.Home" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:alertDialogTheme">@style/Noiro.MenuDialog</item>
        <item name="android:windowBackground">@color/home_background</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
    <style name="Noiro.MenuDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/noiro_menu_panel</item>
        <item name="android:colorAccent">#9DA8FF</item>
        <item name="android:textColorPrimary">#F4F5FA</item>
        <item name="android:textColorSecondary">#AFB8CB</item>
        <item name="android:colorBackground">#181D27</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:windowElevation">24dp</item>
        <item name="android:windowMinWidthMajor">45%</item>
        <item name="android:windowMinWidthMinor">55%</item>
        <item name="android:listSelector">@drawable/noiro_menu_focus</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Noiro.MenuButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Noiro.MenuButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/Noiro.MenuButton</item>
    </style>
    <style name="Noiro.MenuButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/noiro_menu_button</item>
        <item name="android:textColor">@color/noiro_menu_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:layout_margin">6dp</item>
    </style>
</resources>
