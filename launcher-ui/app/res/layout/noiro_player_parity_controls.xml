<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <View android:id="@id/exo_controls_background" android:layout_width="match_parent"
        android:layout_height="match_parent" android:background="@drawable/noiro_player_parity_scrim" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingTop="16dp">
        <TextView android:id="@+id/noiro_player_close" style="@style/Noiro.PlayerMenu"
            android:layout_width="48dp" android:text="⌄" android:textSize="26sp" android:contentDescription="Close player"
            android:nextFocusDown="@id/exo_rew" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingLeft="14dp" android:paddingRight="14dp">
            <TextView android:id="@+id/noiro_player_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end"
                android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/noiro_player_metadata" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end"
                android:textColor="#C6CBD2" android:textSize="14sp" />
        </LinearLayout>
        <TextView android:id="@+id/noiro_player_previous" style="@style/Noiro.PlayerMenu" android:layout_width="48dp"
            android:text="‹" android:textSize="26sp" android:contentDescription="Previous episode" android:visibility="gone" android:nextFocusDown="@id/exo_play_pause" />
        <TextView android:id="@+id/noiro_player_next" style="@style/Noiro.PlayerMenu" android:layout_width="48dp"
            android:text="›" android:textSize="26sp" android:contentDescription="Next episode" android:visibility="gone" android:nextFocusDown="@id/exo_play_pause" />
        <TextView android:id="@+id/noiro_player_segments" style="@style/Noiro.PlayerMenu" android:layout_width="48dp"
            android:text="✓" android:textSize="24sp" android:contentDescription="Edit skip segments" android:visibility="gone" android:nextFocusDown="@id/exo_play_pause" />
        <TextView android:id="@+id/noiro_player_restart" style="@style/Noiro.PlayerMenu"
            android:layout_width="48dp" android:text="↶" android:textSize="25sp" android:contentDescription="Restart video"
            android:nextFocusDown="@id/exo_play_pause" />
        <TextView android:id="@+id/noiro_player_settings" style="@style/Noiro.PlayerMenu"
            android:layout_width="48dp" android:text="⚙" android:textSize="25sp" android:contentDescription="Player settings"
            android:nextFocusDown="@id/exo_ffwd" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="80dp"
        android:layout_gravity="center" android:orientation="horizontal" android:gravity="center">
        <ImageButton android:id="@id/exo_rew" style="@style/Noiro.PlayerButton"
            android:layout_width="64dp" android:layout_height="64dp"
            android:contentDescription="Rewind 10 seconds" android:nextFocusUp="@id/noiro_player_close" android:nextFocusDown="@id/exo_progress" />
        <ImageButton android:id="@id/exo_play_pause" style="@style/Noiro.PlayerButton"
            android:layout_width="72dp" android:layout_height="72dp"
            android:contentDescription="Play or pause" android:nextFocusUp="@id/noiro_player_restart" android:nextFocusDown="@id/exo_progress" />
        <ImageButton android:id="@id/exo_ffwd" style="@style/Noiro.PlayerButton"
            android:layout_width="64dp" android:layout_height="64dp"
            android:contentDescription="Forward 10 seconds" android:nextFocusUp="@id/noiro_player_settings" android:nextFocusDown="@id/exo_progress" />
    </LinearLayout>
    <FrameLayout android:id="@id/exo_bottom_bar" android:layout_width="match_parent"
        android:layout_height="112dp" android:layout_gravity="bottom"
        android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingBottom="16dp" android:layoutDirection="ltr">
        <TextView android:id="@id/exo_position" android:layout_width="wrap_content" android:layout_height="32dp"
            android:layout_gravity="top|left" android:gravity="center_vertical" android:textColor="#FFFFFF" android:textSize="15sp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|right" android:orientation="vertical" android:gravity="right">
            <TextView android:id="@id/exo_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="15sp" />
            <TextView android:id="@+id/noiro_player_ends" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#B4BAC3" android:textSize="13sp" />
        </LinearLayout>
        <HorizontalScrollView android:id="@id/exo_basic_controls" android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_gravity="bottom" android:scrollbars="none" android:fillViewport="true">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/noiro_player_speed" style="@style/Noiro.PlayerMenu" android:layout_width="112dp"
                android:text="Speed" android:contentDescription="Playback speed" android:nextFocusUp="@id/exo_progress" />
            <TextView android:id="@+id/noiro_subtitles" style="@style/Noiro.PlayerMenu" android:layout_width="112dp"
                android:text="Subtitles" android:contentDescription="Subtitles" android:nextFocusUp="@id/exo_progress" />
            <TextView android:id="@+id/noiro_subtitle_sync" style="@style/Noiro.PlayerMenu" android:layout_width="136dp"
                android:text="Subtitle sync" android:contentDescription="Subtitle sync" android:nextFocusUp="@id/exo_progress" />
            <TextView android:id="@id/exo_audio_track" style="@style/Noiro.PlayerMenu" android:layout_width="112dp"
                android:text="Audio" android:contentDescription="Audio" android:nextFocusUp="@id/exo_progress" />
            <TextView android:id="@+id/noiro_player_aspect" style="@style/Noiro.PlayerMenu" android:layout_width="112dp"
                android:text="Aspect" android:contentDescription="Aspect ratio" android:nextFocusUp="@id/exo_progress" />
            <TextView android:id="@+id/noiro_player_quality" style="@style/Noiro.PlayerMenu" android:layout_width="112dp"
                android:text="Quality" android:contentDescription="Quality" android:visibility="gone" android:nextFocusUp="@id/exo_progress" />
            <TextView android:id="@+id/noiro_player_sources" style="@style/Noiro.PlayerMenu" android:layout_width="112dp"
                android:text="Sources" android:contentDescription="Sources" android:visibility="gone" android:nextFocusUp="@id/exo_progress" />
            <TextView android:id="@+id/noiro_player_episodes" style="@style/Noiro.PlayerMenu" android:layout_width="112dp"
                android:text="Episodes" android:contentDescription="Episodes" android:visibility="gone" android:nextFocusUp="@id/exo_progress" />
            <TextView android:id="@+id/noiro_player_chapters" style="@style/Noiro.PlayerMenu" android:layout_width="112dp"
                android:text="Chapters" android:contentDescription="Chapters" android:visibility="gone" android:nextFocusUp="@id/exo_progress" />
            <TextView android:id="@+id/noiro_player_grab" style="@style/Noiro.PlayerMenu" android:layout_width="112dp"
                android:text="Grab" android:contentDescription="Grab" android:visibility="gone" android:nextFocusUp="@id/exo_progress" />
            <TextView android:id="@+id/noiro_player_info" style="@style/Noiro.PlayerMenu" android:layout_width="112dp"
                android:text="Info" android:contentDescription="Playback information" android:nextFocusUp="@id/exo_progress" />
            <TextView android:id="@+id/noiro_player_sleep" style="@style/Noiro.PlayerMenu" android:layout_width="112dp"
                android:text="Sleep" android:contentDescription="Sleep timer" android:nextFocusUp="@id/exo_progress" />
            </LinearLayout>
        </HorizontalScrollView>
        <TextView android:id="@+id/noiro_player_action_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <!-- Keep the existing IDs available without presenting duplicate controls. -->
        <ImageButton android:id="@+id/noiro_subtitle_settings" style="@style/Noiro.PlayerButton" android:visibility="gone" />
        <ImageButton android:id="@id/exo_settings" style="@style/Noiro.PlayerButton" android:visibility="gone" />
    </FrameLayout>
    <tv.noiro.launcher.PlayerTimelineView android:id="@id/exo_progress" android:layout_width="match_parent" android:layout_height="28dp"
        android:layout_gravity="bottom" android:layout_marginBottom="112dp" android:layout_marginLeft="24dp" android:layout_marginRight="24dp"
        android:nextFocusUp="@id/exo_play_pause" android:nextFocusDown="@id/noiro_player_speed" app:played_color="#6271FF" app:scrubber_color="#FFFFFF"
        app:buffered_color="#88FFFFFF" app:unplayed_color="#663C3C42" />
</merge>
